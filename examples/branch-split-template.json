{
  "template_version": 1,
  "operation": "split",
  "structure": {
    "header_mode": "row_number",
    "header_row": 1,
    "header_end_row": 1,
    "data_start_row": 2,
    "skip_bottom_rows": 0,
    "drop_empty_rows": true,
    "drop_empty_columns": true
  },
  "rules": {
    "mode": "by_field",
    "fields": "Branch",
    "rows_per_file": 500,
    "parts": 5,
    "distribution": "fixed_limit"
  },
  "output": {
    "naming_template": "{original_name}_{split_field}-{split_value}",
    "prefix": "",
    "suffix": "",
    "add_source_file": true,
    "add_source_sheet": true,
    "overwrite": false
  }
}

